build/
build/docs
# Per-flavour build directories, e.g. --build-dir build-coverage
build-*/
thirdparty/

# Deploy/runtime artefact trees (produced by build.py install / devenv.py; never committed)
installed/
# Instrumented builds stage into installed-coverage/, installed-asan/, etc.
installed-*/
# Release tarballs staged by release.py -- output, like build/ and installed/
release/
# Runtime working directory: component logs and other output written while running
run/

# Prometheus TSDB. Outside installed/ deliberately -- that tree is rebuilt, and measurement
# history is meant to outlive a redeploy so runs weeks apart stay comparable.
var/

# Manually placed JDBC drivers (see db/create_db.py --help for options)
db/drivers/

# Python build artefacts
__pycache__/
*.egg-info/
python/build/
python/errors.txt
docker-deps/

# Admin service user store — created automatically on first run; contains hashed passwords
admin_users.toml

# Obsidian vault config (editor state; appears wherever docs are opened as a vault)
.obsidian/

# The FIX serialisation .dsl and .hpp are generated into the build tree
# (build/generated_dsl/fix_orders.{dsl,hpp}) -- never the source tree -- so there is
# nothing to ignore here. See CMakeLists.txt / docs/fix/pdu_generation.md.

# clang-tidy output, regenerated on every scripts/sca.py run. The summaries are a snapshot
# of one run against one tree, so a committed copy would be stale the next time anyone ran
# it. Note clang-summary-prev.txt is deliberately NOT here: it is a baseline kept by hand to
# diff against, not something the run produces.
clang-output.txt
clang-summary.txt
clang-summary-byfile.txt

# The venue book: build artefacts.  The sources are docs/book/**.tex, the .sty
# and requirement_ids.txt; everything below is regenerated by "make -C docs/book".
docs/book/*.pdf
docs/book/*.aux
docs/book/*.log
docs/book/*.toc
docs/book/*.out
docs/book/*.req
docs/book/*.glo
docs/book/*.gls
docs/book/*.glg
docs/book/*.acn
docs/book/*.acr
docs/book/*.alg
docs/book/*.ist
docs/book/*.txt
docs/book/*.html
docs/book/*.docx
docs/book/*.css
docs/book/*.lg
docs/book/*.xref
docs/book/*.tmp
docs/book/*.idv
docs/book/*.4ct
docs/book/*.4tc
docs/book/*.dvi
docs/book/**/*.aux
