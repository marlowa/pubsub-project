build/
build/docs
thirdparty/

# Deploy/runtime artefact trees (produced by build.py install / devenv.py; never committed)
installed/
# Instrumented builds stage into installed-coverage/, installed-asan/, etc.
installed-*/

# Manually placed JDBC drivers (see db/create_db.py --help for options)
db/drivers/

# Python build artefacts
__pycache__/
*.egg-info/
python/build/
python/errors.txt
docker-deps/

# Admin service user store — created automatically on first run; contains hashed passwords
admin_users.toml

# Obsidian vault config (editor state; appears wherever docs are opened as a vault)
.obsidian/

# The FIX serialisation .dsl and .hpp are generated into the build tree
# (build/generated_dsl/fix_orders.{dsl,hpp}) -- never the source tree -- so there is
# nothing to ignore here. See CMakeLists.txt / docs/design/fix_pdu_generation.md.
