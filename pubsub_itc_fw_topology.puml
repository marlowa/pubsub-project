@startuml pubsub_itc_fw_topology
' =====================================================================
' pubsub_itc_fw deployment topology
' Single-site, single-instrument view of the WAL+HA design.
' See docs/framework/topology.md for the companion explanation.
' =====================================================================

' Layout direction. PlantUML's auto-layout will still struggle with
' the number of lines; this just sets the dominant flow.
left to right direction

' Style overrides for legibility.
skinparam nodesep 30
skinparam ranksep 50
skinparam shadowing false
skinparam node {
    BackgroundColor #FAFAFA
    BorderColor     #555555
    FontColor       #222222
}
skinparam component {
    BackgroundColor #EEF6FF
    BorderColor     #336699
}
skinparam database {
    BackgroundColor #FFF6E0
    BorderColor     #B07A1F
}

' Edge style legend (also documented in the companion .md):
'   solid black     -- data-plane connection
'   dotted blue     -- control-plane connection (lease requests and arbiter state)
'   each direction is shown as a separate arrow

' =====================================================================
' FIX clients (external; representative)
' =====================================================================
node "fix8-client-1\n(machine)"  as FIX1
node "fix8-client-2\n(machine)"  as FIX2

' =====================================================================
' One gateway protocol's two instances, a and b
' =====================================================================
node "gateway-1 (machine)" as GW1_M {
    component "Gateway\n(instance a)" as GW1
}
node "gateway-2 (machine)" as GW2_M {
    component "Gateway\n(instance b)" as GW2
}

' =====================================================================
' Sequencer pair (two machines, primary and secondary)
' =====================================================================
node "sequencer-primary\n(machine)" as SP_M {
    component "Sequencer\n(instance, configured PRIMARY)" as SP
    database  "WAL\n(local disk,\nmmap, segmented)" as SP_WAL
    SP -- SP_WAL
}
node "sequencer-secondary\n(machine)" as SS_M {
    component "Sequencer\n(instance, configured SECONDARY)" as SS
    database  "WAL\n(local disk,\nmmap, segmented)" as SS_WAL
    SS -- SS_WAL
}

' =====================================================================
' ME pair (two machines, primary and secondary)
' =====================================================================
node "ME-primary\n(machine)" as MP_M {
    component "Matching Engine\n(instance, configured PRIMARY)" as MP
    database  "Order book\n(in memory)" as MP_BOOK
    MP -- MP_BOOK
}
node "ME-secondary\n(machine)" as MS_M {
    component "Matching Engine\n(instance, configured SECONDARY)" as MS
    database  "Order book\n(replicated,\nin memory)" as MS_BOOK
    MS -- MS_BOOK
}

' =====================================================================
' Arbiter pool: two arbiters and a witness
' Three machines, in failure-independent locations.
' =====================================================================
node "arbiter-primary (machine)" as AP_M {
    component "Arbiter\n(instance, configured PRIMARY)" as AP
    database  "Promise file;\nhighest epoch\nper group" as AP_MAP
    AP -- AP_MAP
}
node "arbiter-secondary (machine)" as AS_M {
    component "Arbiter\n(instance, configured SECONDARY)" as AS
    database  "Promise file;\nhighest epoch\nper group" as AS_MAP
    AS -- AS_MAP
}
node "witness\n(machine, failure-independent\npower / switch / segment)" as W_M {
    component "Witness\n(nothing on disk; vote only)" as W
}

' =====================================================================
' Data-plane connections (solid black)
' Each direction shown as a separate arrow, labelled with what flows.
' =====================================================================

' --- FIX wire: fix8 client <-> gateway (each client logs on to one instance at a time)
FIX1 --> GW1 : "FIX orders, logon,\nheartbeats, resends"
GW1  --> FIX1 : "FIX execution reports,\nlogon ack, heartbeats"

FIX2 --> GW2 : "FIX orders, logon,\nheartbeats, resends"
GW2  --> FIX2 : "FIX execution reports,\nlogon ack, heartbeats"

' --- Gateway -> Sequencer (orders)
'     Each gateway holds open TCP connections to BOTH sequencers and
'     sends every command, wrapped in a WalRecord, to both. Only the
'     leading sequencer acts on it.
GW1 --> SP : "commands\n(to both; leader acts)"
GW1 --> SS : "commands\n(to both; leader acts)"
GW2 --> SP : "commands\n(to both; leader acts)"
GW2 --> SS : "commands\n(to both; leader acts)"

' --- Sequencer -> Gateway (ERs)
'     Each sequencer opens a connection to every gateway process's
'     ER listener.
SP --> GW1 : "ER PDUs,\norder acceptance"
SP --> GW2 : "ER PDUs,\norder acceptance"
SS --> GW1 : "ER PDUs,\norder acceptance"
SS --> GW2 : "ER PDUs,\norder acceptance"

' --- Sequencer -> ME (sequenced orders)
'     Each sequencer holds open connections to BOTH MEs.
SP --> MP : "sequenced commands"
SP --> MS : "sequenced commands"
SS --> MP : "sequenced commands"
SS --> MS : "sequenced commands"

' --- ME -> Sequencer (ERs)
'     Each ME connects to BOTH sequencers' ER listeners and sends each
'     report to both.
MP --> SP : "ER PDUs"
MP --> SS : "ER PDUs"
MS --> SP : "ER PDUs"
MS --> SS : "ER PDUs"

' --- Sequencer WAL replication (within sequencer pair)
'     Leader pushes WAL records, follower acks. The same pair of
'     connections carries each instance's lease requests to its peer.
SP --> SS : "WAL records\n(leader -> follower)"
SS --> SP : "WAL acks\n(follower -> leader)"

' --- ME book replication (within ME pair)
'     The configured primary sends book updates to the secondary. Nothing
'     is acknowledged. The same connections carry each instance's lease
'     requests to its peer.
MP --> MS : "book updates\n(no acknowledgement)"

' =====================================================================
' Control-plane connections (dotted blue)
' Each instance of a pair opens TCP to BOTH arbiters and sends each
' lease request to both. Only the active arbiter answers.
' =====================================================================

' --- Sequencer primary <-> arbiter pair
SP .[#0066CC]u.> AP : "lease request"
AP .[#0066CC]d.> SP : "lease grant / refusal\n(when active)"
SP .[#0066CC]u.> AS : "lease request"
AS .[#0066CC]d.> SP : "lease grant / refusal\n(when active)"

' --- Sequencer secondary <-> arbiter pair
SS .[#0066CC]u.> AP : "lease request"
AP .[#0066CC]d.> SS : "lease grant / refusal\n(when active)"
SS .[#0066CC]u.> AS : "lease request"
AS .[#0066CC]d.> SS : "lease grant / refusal\n(when active)"

' --- ME primary <-> arbiter pair
MP .[#0066CC]u.> AP : "lease request"
AP .[#0066CC]d.> MP : "lease grant / refusal\n(when active)"
MP .[#0066CC]u.> AS : "lease request"
AS .[#0066CC]d.> MP : "lease grant / refusal\n(when active)"

' --- ME secondary <-> arbiter pair
MS .[#0066CC]u.> AP : "lease request"
AP .[#0066CC]d.> MS : "lease grant / refusal\n(when active)"
MS .[#0066CC]u.> AS : "lease request"
AS .[#0066CC]d.> MS : "lease grant / refusal\n(when active)"

' --- Arbiter pair: deciding which is active, and the active one's state
AP .[#0066CC].> AS : "lease request / grant;\nhighest epoch per group"
AS .[#0066CC].> AP : "lease request / grant;\nhighest epoch per group"

' --- Arbiter -> Witness (each arbiter asks; the witness votes)
AP .[#0066CC].> W : "lease request"
W  .[#0066CC].> AP : "lease grant / refusal"
AS .[#0066CC].> W : "lease request"
W  .[#0066CC].> AS : "lease grant / refusal"

' =====================================================================
' Legend
' =====================================================================
legend bottom
|= Line style |= Meaning |
| solid black arrow | Data-plane TCP connection (FIX wire, commands, ER PDUs, WAL and book replication) |
| dotted blue arrow | Control-plane TCP connection (lease requests: component <-> arbiter, arbiter <-> arbiter, arbiter <-> witness) |
| each direction = one arrow | Bidirectional channels are drawn as two arrows, each labelled with what flows in that direction |
endlegend

@enduml
