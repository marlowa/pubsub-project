{
  "uid": "pubsub-venue-latency",
  "title": "pubsub venue \u2014 latency and throughput",
  "tags": [
    "pubsub",
    "latency"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 0,
  "refresh": "10s",
  "id": null,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "heatmap",
      "title": "ITC hop \u2014 $component \u2014 queue wait + wakeup",
      "description": "Time from a message being enqueued to it being dispatched: the queue wait plus the wakeup (the eventfd write and the epoll_wait return). Message construction happens before the stamp, so none of it is in here.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pubsub-prom"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "pubsub-prom"
          },
          "expr": "sum by (le) (rate(itc_queue_latency_nanoseconds_bucket{application=\"pubsub\", component=\"$component\"}[$__rate_interval]))",
          "legendFormat": "{{le}}",
          "editorMode": "code",
          "range": true,
          "format": "heatmap"
        }
      ],
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Turbo",
          "steps": 64,
          "exponent": 0.5,
          "reverse": false
        },
        "yAxis": {
          "unit": "ns",
          "axisPlacement": "left"
        },
        "legend": {
          "show": true
        },
        "tooltip": {
          "mode": "single",
          "yHistogram": true
        },
        "filterValues": {
          "le": 1e-09
        }
      }
    },
    {
      "type": "timeseries",
      "title": "ITC hop \u2014 $component \u2014 percentiles by thread",
      "description": "Watch this across the quiet phases of a trading-day run. A thread that sleeps between messages has to be woken for each one, and the cost of that appears here and nowhere else. Full width because it has one line per thread, and the legend is what makes it readable.",
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pubsub-prom"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "pubsub-prom"
          },
          "expr": "histogram_quantile(0.90, sum by (le, component, scope) (rate(itc_queue_latency_nanoseconds_bucket{application=\"pubsub\", component=\"$component\"}[$__rate_interval])))",
          "legendFormat": "{{component}}/{{scope}} p90",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "pubsub-prom"
          },
          "expr": "histogram_quantile(0.99, sum by (le, component, scope) (rate(itc_queue_latency_nanoseconds_bucket{application=\"pubsub\", component=\"$component\"}[$__rate_interval])))",
          "legendFormat": "{{component}}/{{scope}} p99",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ns",
          "min": 0,
          "custom": {
            "spanNulls": false,
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*\\(right axis\\)$"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "reqps"
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    8,
                    4
                  ],
                  "fill": "dash"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
