    {
      "type": "timeseries",
      "title": "Where the time goes \u2014 how far through the venue an order is at each point (median)",
      "description": "Read the GAPS, not the lines. Each line is how much of the round trip had already gone by the time an order reached that point, so the distance between two of them is the time spent in between. The topmost line is the round trip itself, and the legs below it should add up to it -- if they stop adding up, a measurement point is in the wrong place.",
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 75
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pubsub-prom"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "pubsub-prom"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(order_path_elapsed_nanoseconds_bucket{application=\"pubsub\", component=~\"sequencer.*\", scope=\"order_in\"}[$__rate_interval])))",
          "legendFormat": "1. reached the sequencer",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "pubsub-prom"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(order_path_elapsed_nanoseconds_bucket{application=\"pubsub\", component=~\"sequencer.*\", scope=\"order_out\"}[$__rate_interval])))",
          "legendFormat": "2. sequencer sent it on",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "pubsub-prom"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(order_path_elapsed_nanoseconds_bucket{application=\"pubsub\", component=~\"matching_engine.*\", scope=\"order_in\"}[$__rate_interval])))",
          "legendFormat": "3. reached the matching engine",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "pubsub-prom"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(order_path_elapsed_nanoseconds_bucket{application=\"pubsub\", component=~\"matching_engine.*\", scope=\"er_out\"}[$__rate_interval])))",
          "legendFormat": "4. matched, report sent",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
