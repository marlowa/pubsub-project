# .clang-format — 1TBS / OTBS, C++ (RHEL8-friendly)

BasedOnStyle: LLVM
Language: Cpp

# Line length
ColumnLimit: 160

# Indentation
IndentWidth: 4
TabWidth: 4
UseTab: Never
IndentCaseLabels: true
NamespaceIndentation: None

# Do not rewrite namespace-closing comments to repeat the namespace name.
# The project convention (enforced by check_standards.py) is a fixed
# "} // namespaces": repeating the name is fragile -- renaming the namespace at
# the top silently leaves every closing comment wrong.
FixNamespaceComments: false

# Do not add alignment padding across rows of an array/struct initializer;
# lining entries up is fragile when a new entry forces every row to reflow.
AlignArrayOfStructures: None

# 1TBS: braces attach to control statements, functions, classes, etc.
BreakBeforeBraces: Attach

# Keep control-flow multi-line & braced
AllowShortIfStatementsOnASingleLine: false
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Empty
AllowShortFunctionsOnASingleLine: Empty

# Spacing
SpaceBeforeParens: ControlStatements
PointerAlignment: Left
DerivePointerAlignment: false

# Constructor initializer wrapping
BreakConstructorInitializers: BeforeComma
ConstructorInitializerAllOnOneLineOrOnePerLine: true

# Argument/parameter packing
BinPackArguments: true
BinPackParameters: true

# Includes
SortIncludes: true
IncludeBlocks: Preserve
