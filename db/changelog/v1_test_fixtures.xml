    <!-- ================================================================
         test-004 .. test-008  LOADCLIENT comp_ids
         SenderCompIDs used by binary_load_client, the binary gateway's
         counterpart to the fix8 client that CLIENT above serves.

         SCRAM-SHA-256 values derived from password "loadclientpassword",
         4096 iterations, one salt each. That password is not a secret: it
         is BINARY_LOAD_PASSWORD in scripts/perf_run.py, and these are dev
         fixtures for a sandbox, applied only under the "test" context.

         Five of them because the client names its sessions after its
         comp id prefix: one session keeps the bare prefix, and more than
         one appends an index. Four indices covers the documented four
         client run. The gateway refuses a duplicate comp id, so a session
         without its own credential is refused at logon.

         perf_run.py writes these into credentials.toml itself before a run.
         Seeding them here is what makes a HAND-DRIVEN binary_load_client
         work, and survive the next export_credentials.py.
         ================================================================ -->

    <changeSet id="v1-test-004-loadclient-comp-id" author="pubsub" context="test">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM ${tablePrefix}comp_id WHERE comp_id = 'LOADCLIENT'
            </sqlCheck>
        </preConditions>
        <insert tableName="${tablePrefix}comp_id">
            <column name="comp_id"               value="LOADCLIENT"/>
            <column name="firm_id"               value="TEST"/>
            <column name="stored_key"            value="acf1fdd0f96c5f86571333f3761663d2aeed49ae9298a9ca0ee81b548cfe67c3"/>
            <column name="server_key"            value="2701606ec1f4ad11ea930466c9221f4812a7299d14d86297aee27e012566d69d"/>
            <column name="salt"                  value="fe64b4b802f953382a405b7bb489620a"/>
            <column name="iterations"            valueNumeric="4096"/>
            <column name="enabled"               valueBoolean="true"/>
            <column name="force_password_change" valueBoolean="false"/>
            <column name="locked"                valueBoolean="false"/>
            <column name="consecutive_failed_logins" valueNumeric="0"/>
